# EXAMPLE ONLY — no usable credentials. Use PRIVATE settings outside GitHub.
# Existing Sulmara installations must use docs/CORCOVADO_TRANSITION.md first.
WAVELINK_DEPLOYMENT_MODE=COMPANY
COMPANY_ID=corcovado
COMPANY_NAME=Corcovado
PUBLIC_URL=https://corcovado.mywavelink.com
INITIALISE_COMPANY=YES_FIRST_DEPLOY_ONLY
COMPANY_ADMIN_LOGIN=admin
COMPANY_INITIAL_PASSWORD=
COMPANY_SETUP_KEY=
INITIALISE_FICTIONAL_DEMO=NO
DEMO_PUBLIC_ENTRY=NO
# After activation: INITIALISE_COMPANY=NO and remove the two credential fields.
# Never apply COMPANY settings to the existing demo service/disk.
