# OPTIONAL operator settings. Do not commit real values or passwords.
# Existing C01 company activation and PUBLIC_URL must already be correct.
# The demo remains OFF. A configured SMTP sender is NOT evidence of inbox delivery.
WAVELINK_MEMBERSHIP_MODE=OFF
# Enable only on the intended COMPANY service after reviewing deployment/backup:
# WAVELINK_MEMBERSHIP_MODE=INVITE_ONLY
MEMBERSHIP_SMTP_HOST=
MEMBERSHIP_SMTP_PORT=587
MEMBERSHIP_SMTP_TLS=STARTTLS
MEMBERSHIP_SMTP_USERNAME=
MEMBERSHIP_SMTP_PASSWORD=
MEMBERSHIP_SMTP_FROM=
# TLS mode SSL is also supported; set its provider-approved port explicitly.
# COMPANY_ID, COMPANY_NAME, PUBLIC_URL and WAVELINK_DEPLOYMENT_MODE are existing C01 settings.
# No SMTP values enable company email-domain discovery or self-registration.
