+/* UI121: presentation and session-local navigation. No stored data or grants. */
+window.WavelinkUX=(()=>{
+ 'use strict';
+ const text=(pt,en)=>window.WavelinkI18n?.locale==='pt-BR'?pt:en;
+ const escape=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+ const locale=()=>window.WavelinkI18n?.locale==='pt-BR'?'pt-BR':'en-GB';
+ const date=value=>/^\d{4}-\d{2}-\d{2}$/.test(String(value))?new Intl.DateTimeFormat(locale(),{day:'2-digit',month:'2-digit',year:'numeric',timeZone:'UTC'}).format(new Date(value+'T12:00:00Z')):String(value||text('Não informado','Not recorded'));
+ const initials=name=>String(name||'').trim().split(/\s+/).filter(Boolean).slice(0,2).map(w=>Array.from(w)[0]).join('').toLocaleUpperCase();
+ const fold=value=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase();
+ let H=null,owner='',lastOperations='#home',lastHR='#hr',bar=null;
+ function validRoute(hash){return /^#[A-Za-z0-9_/-]+$/.test(hash)&&hash.length<240;}
+ function reset(){lastOperations='#home';lastHR='#hr';}
+ function sync(){
+  if(!H)return;
+  const who=H.session(),person=H.person();
+  if(who!==owner){owner=who;reset();}
+  const nav=document.getElementById('workspace-nav'),root=document.getElementById('app');
+  if(!bar){bar=document.createElement('nav');bar.id='wl-workspace-context';bar.setAttribute('aria-label',text('Contexto e troca de área','Workspace context and switcher'));root?.before(bar);}
+  const enabled=!!person?.user_id&&!!nav&&!nav.hidden&&person.fleet_mode!=='vessel_only';
+  bar.hidden=!enabled;document.body.classList.toggle('wl-ui121',enabled);
+  if(!enabled){bar.replaceChildren();reset();return;}
+  const hash=location.hash||'#home',inHR=/^#hr(?:\/|$)/.test(hash);
+  const active=nav.querySelector('a[aria-current="page"]');
+  const activeKey=active?.dataset.workspace||'home';
+  if(validRoute(hash)){
+   if(inHR)lastHR=hash;
+   else if(!['profile','team','workspaces','admin','members','builders'].includes(activeKey))lastOperations=hash;
+  }
+  const label=inHR?(root?.querySelector('h1')?.textContent?.trim()||text('Visão geral','Overview')):(active?.textContent?.trim()||text('Início','Home'));
+  const section=inHR?text('Recursos Humanos','Human Resources'):['admin','members','builders'].includes(activeKey)?text('Administração','Administration'):text('Operações','Operations');
+  const html='<div class="ux-context-path"><span>'+escape(section===label?text('Área de trabalho','Workspace'):section)+'</span><span aria-hidden="true">/</span><strong>'+escape(label)+'</strong></div><div class="ux-context-links">'+(inHR?'<a href="'+escape(lastOperations)+'" data-ux-return>'+escape(text('Retomar Operações','Resume Operations'))+'</a>':H.can('hr.view_own')?'<a href="'+escape(lastHR)+'">'+escape(text('Abrir Recursos Humanos','Open Human Resources'))+'</a>':'')+'<a href="#workspaces">'+escape(text('Todas as áreas','All workspaces'))+'</a></div>';
+  if(bar.innerHTML!==html)bar.innerHTML=html;
+  for(const link of document.querySelectorAll('[data-ux-operations]'))link.setAttribute('href',lastOperations);
+ }
+ function init(h){H=h;const root=document.getElementById('app');if(root)root.tabIndex=-1;
+  if(!document.getElementById('wl-skip-content')){const a=document.createElement('a');a.id='wl-skip-content';a.href='#app';a.textContent=text('Ir para o conteúdo','Skip to content');a.onclick=e=>{e.preventDefault();root?.focus();};document.body.prepend(a);}
+  sync();
+ }
+ return Object.freeze({text,escape,date,initials,fold,init,sync,operations:()=>lastOperations});
+})();
