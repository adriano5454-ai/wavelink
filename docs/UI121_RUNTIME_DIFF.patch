+@pytest.mark.parametrize('locale,expected', [('pt-BR','Cadastro do colaborador'),('en','Employee record')])
+def test_authored_captions_follow_company_locale(locale,expected):
+    with patch('app.hr_text_ui121.company_locale',return_value=locale):
+        assert hr_text('Cadastro do colaborador')==expected
+        assert hr_text('Texto de usuário não catalogado')=='Texto de usuário não catalogado'
+
+@pytest.mark.parametrize('locale,event', [('pt-BR','Embarque previsto'),('en','Planned joining')])
+def test_calendar_localizes_event_caption_not_saved_title(company,locale,event):
+    with patch('app.hr_text_ui121.company_locale',return_value=locale):
+        saved=company.action('save_shift',shift(company.uid('bob'),title='Embarque previsto',start_on='2026-10-18',end_on='2026-10-20',assignment_type='offshore'),key='hr')
