+def seed(c, owner, author):
+    # The actual additive component creates/validates its own schema. Synthetic
+    # committed evidence fills each independent privacy-bearing table, including
+    # a retired original file and a saved receipt without duplicated file bytes.
+    from app.hr import ensure
+    ensure(c)
+    record_id, file_id, operation_id = [str(uuid.uuid4()) for _ in range(3)]
+    at = '2026-10-14T00:00:00Z'
+    body = dict(id=record_id, kind='documents', version=1, user_id=owner,
+                title='Fictional recorded medical evidence', type='medical',
+                reference='FICTIONAL-117', issuer='Fictional issuer', issued_on='',
+                expiry_mode='unknown', expires_on='', reminder_days=90, notes=MARK,
+                archived=False, created_at=at, updated_at=at,
+                created_by=author, updated_by=author, files=[])
+    c.execute('INSERT INTO hr_records(id,kind,user_id,updated_at,body) VALUES(?,?,?,?,?)',
+              (record_id, 'documents', owner, at, pack(body)))
+    c.execute('''INSERT INTO hr_files(id,kind,record_id,filename,mime,sha256,size,data,
+                 added_at,added_by,removed_at) VALUES(?,?,?,?,?,?,?,?,?,?,?)''',
+              (file_id, 'documents', record_id, 'fictional-evidence.pdf', 'application/pdf',
+               hashlib.sha256(FILE).hexdigest(), len(FILE), FILE, at, author, at))
+    c.execute('''INSERT INTO hr_audit(kind,record_id,user_id,at,actor,action,before_body,after_body)
+                 VALUES(?,?,?,?,?,?,?,?)''',
+              ('documents', record_id, owner, at, author, 'save_document', '{}', pack(body)))
+    c.execute('''INSERT INTO hr_operations(id,fingerprint,result,kind,record_id,user_id,
+                 actor_id,action,at) VALUES(?,?,?,?,?,?,?,?,?)''',
+              (operation_id, hashlib.sha256(MARK.encode()).hexdigest(), pack(body),
+               'documents', record_id, owner, author, 'save_document', at))
+    return record_id
+
+
+def rows(c):
+    return {table: [tuple(row) for row in c.execute('SELECT * FROM ' + table + ' ORDER BY rowid')]
+            for table in sorted(HR_TABLES)}
+
+
+def add_evidence(company):
+    manager, _, admin, _, supervisor = company
+    with manager.store.connection(True) as c:
