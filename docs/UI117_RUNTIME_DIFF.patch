+
+    def overview(self, actor, user_id=''):
+        with self.store.connection() as c:
+            user, capabilities = current(c, actor)
+            owner = user_id or user['id']; person = self._target(c,owner)
+            if owner!=user['id'] and not any(capabilities[key] for key in MANAGE.values()):
