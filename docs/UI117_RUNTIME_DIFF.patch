+"""Private HR HTTP boundaries: named account, exact company and bounded JSON."""
+import asyncio
+import json
+from pathlib import Path
+from urllib.parse import quote
+
+from fastapi import Depends, Request
+from fastapi.responses import JSONResponse, Response
+from pydantic import ValidationError
+
+from .fieldwork_api import Action
+from .hr import MAX_REQUEST_BYTES
+from .store import Problem
+
+PRIVATE_HEADERS = {'Cache-Control':'no-store', 'X-Content-Type-Options':'nosniff',
+                   'Referrer-Policy':'no-referrer'}
+
+
+def attach(app, store, config, actor):
+    def logged(request:Request, person=Depends(actor)):
+        if len(request.headers.getlist('x-aj-hub-id'))!=1 or request.headers.get('x-aj-hub-id')!=config['hub_id']:
+            raise Problem(409,'Confirm this exact company workspace before opening private HR records.',hub_changed=True,hub_id=config['hub_id'])
+        if len(request.headers.getlist('authorization'))!=1:
+            raise Problem(401,'Use one named company session for private HR records.')
+        return person
+
+    def response(data):
+        return JSONResponse(data,headers=PRIVATE_HEADERS)
+
+    @app.get('/api/hr/directory')
+    def directory(person=Depends(logged)):
+        return response(store.hr.directory(person))
+
+    @app.get('/api/hr/overview')
+    def overview(user_id:str='',person=Depends(logged)):
+        return response(store.hr.overview(person,user_id))
+
+    @app.get('/api/hr/review-queue')
+    def review_queue(person=Depends(logged)):
+        return response(store.hr.review_queue(person))
+
+    @app.get('/api/hr/records')
+    def records(kind:str,user_id:str='',offset:int=0,limit:int=100,person=Depends(logged)):
+        return response(store.hr.records(person,kind,user_id,offset,limit))
+
+    @app.get('/api/hr/{kind}/{record_id}/history')
+    def history(kind:str,record_id:str,person=Depends(logged)):
+        return response(store.hr.history(kind,record_id,person))
+
+    @app.get('/api/hr/{kind}/{record_id}/files/{file_id}')
+    def file(kind:str,record_id:str,file_id:str,person=Depends(logged)):
+        content,mime,name=store.hr.file(kind,record_id,file_id,person)
+        headers=dict(PRIVATE_HEADERS)
+        headers['Content-Security-Policy']="default-src 'none'; frame-ancestors 'none'; sandbox"
+        headers['X-Frame-Options']='DENY'
+        headers['Content-Disposition']='attachment; filename="HR_attachment'+Path(name).suffix.lower()+'"; filename*=UTF-8\'\''+quote(name,safe='')
+        return Response(content,media_type=mime,headers=headers)
+
+    @app.get('/api/hr/{kind}/{record_id}')
+    def record(kind:str,record_id:str,person=Depends(logged)):
+        return response(store.hr.get(kind,record_id,person))
+
+    @app.post('/api/hr/action')
+    async def action(request:Request,person=Depends(logged)):
+        if request.headers.get('content-type','').split(';',1)[0].strip().lower()!='application/json':
+            raise Problem(415,'Submit HR actions as JSON.')
+        def unique(pairs):
+            result={}
+            for key,value in pairs:
+                if key in result: raise ValueError('Duplicate field')
+                result[key]=value
+            return result
+        def nonfinite(_): raise ValueError('Nonfinite number')
+        body=bytearray()
+        async for chunk in request.stream():
+            if len(body)+len(chunk)>MAX_REQUEST_BYTES:
+                raise Problem(413,'The HR request exceeds 8 MiB. Use smaller files or shorter text.')
+            body.extend(chunk)
+        try:
+            value=json.loads(body,object_pairs_hook=unique,parse_constant=nonfinite)
+            payload=Action.model_validate(value)
+        except (ValueError,UnicodeError,RecursionError,ValidationError):
+            raise Problem(422,'Invalid HR action. Review its fields and retry.') from None
+        result=await asyncio.to_thread(store.hr.run,payload.action,payload.payload,person,payload.op_id)
+        return response(result)
