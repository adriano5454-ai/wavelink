+def test_hr_scope_change_during_derivation_refuses_stale_titles(hub, monkeypatch):
+    h = hub
+    document(h)
+    actor = h.users['worker']['actor']
+    original = h.store.hr.alerts
+
+    def revoke_after_read(current_actor, *, complete=False):
+        result = original(current_actor, complete=complete)
+        permissions = access.defaults('technician')
+        permissions.update({k: False for k in access.KEYS if k.startswith('hr.')})
