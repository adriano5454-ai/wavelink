+"""Temporary company data and captured transport only; never send real mail."""
+from dataclasses import replace
+from datetime import date, timedelta
+import json
+import uuid
+
+import pytest
+
+from app import access, company_roles, membership_policy
+from app.action_center import ACTION_CATEGORIES, _default_preferences
+from app.email_alerts import defaults as email_defaults, validate as validate_email
+from app.store import Problem, pack, utcnow
+from tests.rebrand.test_inherited_review import hub
+from tests.ui65_roles_access.conftest import h as membership_fixture
+
+
+class CapturedMailbox:
+    ready = True
+
+    def __init__(self):
+        self.messages = []
+
+    def send(self, recipient, subject, body):
+        self.messages.append((recipient, subject, body))
+
+
+@pytest.fixture
+def role_hub(tmp_path):
+    yield from membership_fixture.__wrapped__(tmp_path)
+
+
+def document(h, who='worker', *, title='Private fictional passport', expiry=None, **changes):
+    payload = dict(id='', version=0, user_id=h.users[who]['id'], type='passport', title=title,
+        reference='PRIVATE-REFERENCE-117', issuer='Fictional issuer', issued_on='',
+        expiry_mode='dated', expires_on=expiry or (date.today() + timedelta(days=10)).isoformat(),
+        reminder_days=90, notes='Private HR notes')
+    payload.update(changes)
+    return h.store.hr.run('save_document', payload, h.admin, str(uuid.uuid4()))
+
+
+def hr_events(h, actor):
+    return h.store.action_center.list(actor, category='hr', limit=100)
+
+
+def install_email(h, actor, categories):
+    service = h.app.state.email_alerts
+    service.settings = replace(service.settings, enabled=True,
+        origin='https://fictional.example.test', company_name='Fictional HR Company')
+    service.mailer = CapturedMailbox()
+    service.operator_enabled = True
+    with h.store.connection(True) as c:
+        c.execute('INSERT INTO email_alert_mailboxes VALUES(?,?,?)',
+            (actor['user_id'], 'fictional.employee@example.test', utcnow()))
+    service.save(actor, str(uuid.uuid4()), 0,
+        dict(email_defaults(), enabled=True, categories=categories))
+    return service
+
+
+def save_direct_permissions(h, uid, permissions):
+    # Deliberately do not bump credential_version: the projection must also
+    # defend against a source-scope change between its independent reads.
+    with h.store.connection(True) as c:
+        c.execute('''INSERT INTO account_permissions VALUES(?,?,1,?,?)
+            ON CONFLICT(user_id) DO UPDATE SET permissions=excluded.permissions''',
+            (uid, pack(permissions), utcnow(), h.admin['user_id']))
+
+
+def test_hr_alerts_are_own_or_document_manager_and_never_public(hub):
+    h = hub
+    own = document(h)
+    other = document(h, 'other', title='Other private seaman book')
+    worker = h.users['worker']['actor']
+    stranger = h.users['other']['actor']
+    assert {x['source_key'] for x in hr_events(h, worker)['items']} == {'expiry:' + own['id']}
+    assert {x['source_key'] for x in hr_events(h, stranger)['items']} == {'expiry:' + other['id']}
+    assert {x['source_key'] for x in hr_events(h, h.admin)['items']} == {
+        'expiry:' + own['id'], 'expiry:' + other['id']}
+    assert own['title'] not in str(h.store.recognition.profile(stranger, worker['user_id']))
+    assert h.store.global_search.search(stranger, own['title'])['items'] == []
+    assert own['title'] not in str(h.store.certificates.list(stranger))
+
+
+def test_hr_alert_scope_revocation_removes_events_and_old_receipts(hub):
+    h = hub
+    document(h)
+    actor = h.users['worker']['actor']
+    event = hr_events(h, actor)['items'][0]['event_key']
+    permissions = access.defaults('technician')
+    permissions.update({k: False for k in access.KEYS if k.startswith('hr.')})
+    save_direct_permissions(h, actor['user_id'], permissions)
+    assert hr_events(h, actor)['items'] == []
+    with pytest.raises(Problem) as exc:
+        h.store.action_center.mark(actor, op_id=str(uuid.uuid4()), event_keys=[event], state='read')
+    assert exc.value.code == 409
+
+
+def test_other_hr_review_rights_do_not_grant_staff_document_alerts(hub):
+    h = hub
+    own = document(h)
+    other = document(h, 'other', title='Private colleague passport')
+    actor = h.users['worker']['actor']
+    permissions = dict(access.defaults('technician'), **{'hr.timesheets_review': True})
+    save_direct_permissions(h, actor['user_id'], permissions)
+    assert {item['source_key'] for item in hr_events(h, actor)['items']} == {'expiry:' + own['id']}
+    permissions['hr.documents_manage'] = True
+    save_direct_permissions(h, actor['user_id'], permissions)
+    manager_events = hr_events(h, actor)['items']
+    other_key = next(item['event_key'] for item in manager_events if item['source_key'] == 'expiry:' + other['id'])
+    permissions['hr.documents_manage'] = False
+    save_direct_permissions(h, actor['user_id'], permissions)
+    assert {item['source_key'] for item in hr_events(h, actor)['items']} == {'expiry:' + own['id']}
+    with pytest.raises(Problem) as exc:
+        h.store.action_center.mark(actor, op_id=str(uuid.uuid4()), event_keys=[other_key], state='read')
+    assert exc.value.code == 409
