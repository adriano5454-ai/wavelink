+FORMAT = 'wavelink-hr-1'
+MAX_REQUEST_BYTES = 8 * 1024 * 1024
+MAX_FILE_BYTES = 5 * 1024 * 1024
+MAX_FILES = 6
+LIST_LIMIT = 100
+KINDS = ('documents', 'travel', 'shifts', 'timesheets', 'expenses')
+MANAGE = {'documents':'hr.documents_manage', 'travel':'hr.travel_manage',
+          'shifts':'hr.shifts_manage', 'timesheets':'hr.timesheets_review',
+          'expenses':'hr.expenses_review'}
+HR_KEYS = ('hr.view_own', 'hr.documents_submit', 'hr.documents_manage',
+           'hr.travel_manage', 'hr.shifts_manage', 'hr.timesheets_submit',
+           'hr.timesheets_review', 'hr.expenses_submit', 'hr.expenses_review')
+SAVE_FIELDS = {
+ 'documents': {'id','version','user_id','type','title','reference','issuer','issued_on',
+     'expiry_mode','expires_on','reminder_days','notes'},
+ 'travel': {'id','version','user_id','title','mode','origin','destination','depart_on',
+     'return_on','depart_time','return_time','time_zone','reference','accommodation','status','notes'},
+ 'shifts': {'id','version','user_id','title','location','department_id','start_on','end_on',
+     'shift_name','start_time','end_time','time_zone','status','notes'},
+ 'timesheets': {'id','version','user_id','title','start_on','end_on','entries','notes'},
+ 'expenses': {'id','version','user_id','title','date','category','merchant','amount','currency',
+     'project','description','notes'},
+}
+SAVE_ACTIONS = {'save_document':'documents', 'save_travel':'travel', 'save_shift':'shifts',
+                'save_timesheet':'timesheets', 'save_expense':'expenses'}
+
+
+def ensure(c):
+    c.execute('CREATE TABLE IF NOT EXISTS hr_meta(key TEXT PRIMARY KEY,value TEXT NOT NULL)')
+    row = c.execute("SELECT value FROM hr_meta WHERE key='format'").fetchone()
+    if row and row[0] != FORMAT:
+        raise Problem(409, 'This company uses a different HR storage format. Preserve its database.')
+    c.execute('INSERT OR IGNORE INTO hr_meta VALUES(?,?)', ('format', FORMAT))
+    c.execute('''CREATE TABLE IF NOT EXISTS hr_records(
+        id TEXT PRIMARY KEY,kind TEXT NOT NULL,user_id TEXT NOT NULL,
+        updated_at TEXT NOT NULL,body TEXT NOT NULL)''')
+    c.execute('CREATE INDEX IF NOT EXISTS hr_records_person ON hr_records(kind,user_id,updated_at)')
+    c.execute('''CREATE TABLE IF NOT EXISTS hr_files(
+        id TEXT PRIMARY KEY,kind TEXT NOT NULL,record_id TEXT NOT NULL,
+        filename TEXT NOT NULL,mime TEXT NOT NULL,sha256 TEXT NOT NULL,
+        size INTEGER NOT NULL,data BLOB NOT NULL,added_at TEXT NOT NULL,
+        added_by TEXT NOT NULL,removed_at TEXT NOT NULL DEFAULT '')''')
+    c.execute('CREATE INDEX IF NOT EXISTS hr_files_record ON hr_files(kind,record_id)')
+    c.execute('''CREATE TABLE IF NOT EXISTS hr_audit(
+        seq INTEGER PRIMARY KEY AUTOINCREMENT,kind TEXT NOT NULL,record_id TEXT NOT NULL,
+        user_id TEXT NOT NULL,at TEXT NOT NULL,actor TEXT NOT NULL,action TEXT NOT NULL,
+        before_body TEXT NOT NULL,after_body TEXT NOT NULL)''')
+    c.execute('CREATE INDEX IF NOT EXISTS hr_audit_record ON hr_audit(kind,record_id,seq)')
+    c.execute('''CREATE TABLE IF NOT EXISTS hr_operations(
+        id TEXT PRIMARY KEY,fingerprint TEXT NOT NULL,result TEXT NOT NULL,
+        kind TEXT NOT NULL,record_id TEXT NOT NULL,user_id TEXT NOT NULL,
+        actor_id TEXT NOT NULL,action TEXT NOT NULL,at TEXT NOT NULL)''')
+
+
+def choice(value, options, label):
+    if not isinstance(value, str) or value not in options:
+        raise Problem(422, 'Choose a valid '+label+'.')
+    return value
+
+
+def strict_fields(payload, allowed, required=()):
+    if not isinstance(payload, dict) or set(payload)-set(allowed) or set(required)-set(payload):
+        raise Problem(422, 'Review the HR fields; missing or unsupported fields were supplied.')
+
+
+def identity(user):
+    return {'user_id':user['id'], 'name':user['name'], 'role':user['role']}
+
+
+def current(c, actor):
+    if not isinstance(actor, dict) or not actor.get('user_id') or actor.get('guest') or actor.get('fleet_mode')=='vessel_only':
+        raise Problem(403, 'Use your named approved company account to open private HR records.')
+    user = c.execute('SELECT * FROM users WHERE id=?', (actor['user_id'],)).fetchone()
+    if not user or not user['enabled'] or user['credential_version'] != actor.get('credential_version'):
+        raise Problem(401, 'Your account changed. Sign in again; unsent HR work is kept.')
+    from .membership_policy import state_allowed
+    from .fleet_access import restricted
+    if not state_allowed(c, user) or restricted(c, user['id']):
+        raise Problem(403, 'Approved company access is required for private HR records.')
+    require(c, actor, 'hr.view_own')
+    return dict(user), effective(c, user['id'], user['role'])
+
+
+def expiry_status(record, today=None):
+    today = today or datetime.now(timezone.utc).date()
+    if record.get('expiry_mode') == 'no_expiry': return 'no_expiry'
+    if record.get('expiry_mode') != 'dated' or not record.get('expires_on'): return 'unknown'
+    expiry = date.fromisoformat(record['expires_on'])
+    if expiry < today: return 'expired'
+    if expiry <= today+timedelta(days=record.get('reminder_days',90)): return 'due_soon'
+    return 'current'
+
+
+def decimal_value(value, label, *, positive=False, maximum=None):
+    if not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,12}(?:\.[0-9]{1,2})?', value):
+        raise Problem(422, label+' must be a decimal string with at most two decimal places.')
+    number = Decimal(value)
+    if positive and number <= 0 or maximum is not None and number > maximum:
+        raise Problem(422, label+' is outside the permitted range.')
+    return format(number, '.2f'), number
+
+
+def clock(value, label):
+    value = text(value, label, 5)
+    if value and not re.fullmatch(r'(?:[01]\d|2[0-3]):[0-5]\d', value):
+        raise Problem(422, label+' must use HH:MM.')
+    return value
+
+
+def period(start, end, *, bounded=False):
+    if not start or not end or end < start:
+        raise Problem(422, 'Choose a valid period with its end on or after its start.')
+    if bounded and (date.fromisoformat(end)-date.fromisoformat(start)).days >= 31:
+        raise Problem(422, 'A timesheet period may cover at most 31 calendar days.')
+
+
+class HR:
+    def __init__(self, store):
+        self.store = store
+        with store.connection(True) as c: ensure(c)
+
+    @staticmethod
+    def _raw(c, kind, record_id):
+        choice(kind, KINDS, 'HR record type'); ident(record_id)
+        row = c.execute('SELECT body FROM hr_records WHERE kind=? AND id=?', (kind, record_id)).fetchone()
+        if not row: raise Problem(404, 'This private HR record is not available to your account.')
+        return json.loads(row[0])
+
+    @staticmethod
+    def _read_allowed(record, user, capabilities):
+        return record['user_id']==user['id'] or capabilities.get(MANAGE[record['kind']],False)
+
+    def _require_read(self, record, user, capabilities):
+        if not self._read_allowed(record,user,capabilities):
+            raise Problem(404, 'This private HR record is not available to your account.')
+
+    @staticmethod
+    def _target(c, user_id, *, new=False):
+        ident(user_id)
+        user = c.execute('SELECT * FROM users WHERE id=?', (user_id,)).fetchone()
+        if not user: raise Problem(422, 'Choose a company account for this HR record.')
+        if new:
+            from .membership_policy import state_allowed
+            from .fleet_access import restricted
+            if not user['enabled'] or not state_allowed(c,user) or restricted(c,user_id):
+                raise Problem(422, 'Choose an active approved company account.')
+        return dict(user)
+
+    def _write_allowed(self, kind, record, user_id, user, capabilities, action):
+        owner = user_id==user['id']
+        if kind=='documents':
+            allowed = capabilities['hr.documents_manage'] or owner and capabilities['hr.documents_submit']
+        elif kind in ('travel','shifts'):
+            allowed = capabilities[MANAGE[kind]]
+        elif action.startswith('review_'):
+            allowed = capabilities[MANAGE[kind]] and not owner
+            if owner and capabilities[MANAGE[kind]]:
+                raise Problem(403, 'You cannot approve or return your own submission. Another authorised reviewer must review it.')
+        else:
+            allowed = owner and capabilities['hr.'+kind+'_submit']
+        if not allowed:
+            raise Problem(403 if owner else 404, 'Your account cannot perform this private HR action.')
+        if record: self._require_read(record,user,capabilities)
+
+    @staticmethod
+    def _present(record):
+        result = copy.deepcopy(record)
+        if result['kind']=='documents':
+            result['expiry_status']=result['date_status']=expiry_status(result)
+        return result
+
+    def directory(self, actor):
+        with self.store.connection() as c:
+            user, capabilities = current(c, actor)
+            manager = any(capabilities[key] for key in MANAGE.values())
+            rows = c.execute('SELECT id,name,login_id,enabled FROM users '+('' if manager else 'WHERE id=? ')+'ORDER BY name', () if manager else (user['id'],))
+            people = [dict(row,enabled=bool(row['enabled'])) for row in rows]
+            departments = [dict(row) for row in c.execute('SELECT id,name FROM ops_departments WHERE active=1 ORDER BY name')] if capabilities['hr.shifts_manage'] else []
+            return {'me':{'id':user['id'],'name':user['name']}, 'users':people,
+                    'departments':departments,
+                    'capabilities':{key:capabilities[key] for key in HR_KEYS}}
+
+    def get(self, kind, record_id, actor):
+        with self.store.connection() as c:
+            user, capabilities = current(c, actor)
+            record = self._raw(c,kind,record_id); self._require_read(record,user,capabilities)
+            return self._present(record)
+
+    def records(self, actor, kind, user_id='', offset=0, limit=100):
+        """A bounded page of one authorised person's records, with stable tie order."""
+        choice(kind,KINDS,'HR record type')
+        if type(offset) is not int or not 0<=offset<=1_000_000:
+            raise Problem(422,'Choose a nonnegative HR record offset up to 1,000,000.')
+        if type(limit) is not int or not 1<=limit<=100:
+            raise Problem(422,'An HR record page must contain from 1 to 100 records.')
+        with self.store.connection() as c:
+            user,capabilities=current(c,actor)
+            owner=user_id or user['id']; ident(owner)
+            if owner!=user['id'] and not capabilities[MANAGE[kind]]:
+                raise Problem(404,'This person’s private HR records are not available to your account.')
+            self._target(c,owner)
+            total=c.execute('SELECT count(*) FROM hr_records WHERE kind=? AND user_id=?',(kind,owner)).fetchone()[0]
+            rows=c.execute('SELECT body FROM hr_records WHERE kind=? AND user_id=? ORDER BY updated_at DESC,id LIMIT ? OFFSET ?',
+                (kind,owner,limit,offset)).fetchall()
+            return {'items':[self._present(json.loads(row[0])) for row in rows],
+                'total':total,'offset':offset,'limit':limit,'has_more':offset+len(rows)<total}
+
+    def review_queue(self, actor):
+        """Company review work is scoped separately for each granted reviewer right."""
+        with self.store.connection() as c:
