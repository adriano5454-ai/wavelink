+// Behavioral tests for real form serialization; no browser or production data.
+const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),path=require('node:path');
+const source=fs.readFileSync(path.join(__dirname,'../app/static/hr_workspace.js'),'utf8');
+const sandbox={window:{WavelinkI18n:{t:s=>s,locale:'pt-BR'},addEventListener(){}},location:{hash:'#hr'},document:{},URLSearchParams,Date,Blob,FormData,console};
+const exposed=source.replace('Object.freeze({init,handles','Object.freeze({_test:{payload,actionName,csvCell,T},init,handles');
+sandbox.window.WAVELINK_LOCALE='pt-BR';
+vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../app/static/locale_pt_br.js'),'utf8'),sandbox);
+vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../app/static/i18n_pt_br.js'),'utf8'),sandbox);
+vm.runInNewContext(exposed,sandbox);
+const t=sandbox.window.AJHR._test;
+const plain=x=>JSON.parse(JSON.stringify(x));
+(async()=>{
+ const base={row:{id:'record-id',version:4},values:{id:'record-id',version:4,user_id:'person-id',title:'Teste'}};
+ assert.deepEqual(plain(await t.payload({...base,kind:'documents',mode:'verify',values:{...base.values,decision:'verify',comment:'Conferido'}})),{id:'record-id',version:4,decision:'verify',comment:'Conferido'});
+ assert.equal(t.actionName({kind:'documents',mode:'verify'}),'verify_document');
+ assert.equal(t.actionName({kind:'people',mode:'save'}),'save_person');
+ const person=await t.payload({...base,kind:'people',mode:'save',values:{...base.values,phone:'00',emergency_contact:'Fictício',job_title:'',admitted_on:'',notes:''}});
+ assert.equal(person.phone,'00');assert.equal(typeof person,'object');
+ const expense=await t.payload({...base,kind:'expenses',mode:'save',values:{...base.values,amount:'48,90',currency:'brl'}});
+ assert.equal(expense.amount,'48.90');assert.equal(expense.currency,'BRL');
+ const shift=await t.payload({...base,kind:'shifts',mode:'save',values:{...base.values,work_days:'14',rest_days:'14',required_documents:['passport'],start_time:'',end_time:'',time_zone:''}});
+ assert.equal(shift.work_days,14);assert.deepEqual(plain(shift.required_documents),['passport']);
+ const timesheet=await t.payload({...base,kind:'timesheets',mode:'save',values:{...base.values,start_on:'2026-10-17',end_on:'2026-10-17',entries:[{date:'2026-10-17',hours:'7,5'}]}});
+ assert.equal(timesheet.entries[0].hours,'7.5');
+ await assert.rejects(()=>t.payload({...base,kind:'timesheets',mode:'save',values:{...base.values,start_on:'2026-10-17',end_on:'2026-10-17',entries:[{date:'2026-10-17',hours:'25'}]}}));
+ const reject=await t.payload({...base,kind:'expenses',mode:'review',values:{decision:'reject',comment:'Comprovante ilegível'}});
+ assert.equal(reject.decision,'reject');
+ await assert.rejects(()=>t.payload({...base,kind:'expenses',mode:'review',values:{decision:'reject',comment:''}}));
+ assert.equal(t.actionName({kind:'needs',mode:'save'}),'save_need');
+ const need=await t.payload({...base,kind:'needs',mode:'save',values:{...base.values,headcount:'2'}});assert.equal(need.headcount,2);
+ assert.equal(t.csvCell('=1+1'),'"\'=1+1"');
+ assert.equal(t.csvCell('  @SUM(A1)'),'"\'@SUM(A1)"');
+ assert.equal(t.csvCell('Nome "fictício"'),'"Nome ""fictício"""');
+ assert.equal(t.T(sandbox.window.WavelinkI18n.t('Date')),'Data');
+ assert.equal(t.T('Submitted timesheet days'),'Dias do apontamento enviado');
+ console.log('UI120: 16 behavioral form serialization checks passed.');
+})().catch(e=>{console.error(e);process.exitCode=1;});
