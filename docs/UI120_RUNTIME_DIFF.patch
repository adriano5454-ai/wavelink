+"""UI120 acceptance: fictional people/evidence only, real private HTTP boundaries."""
+import base64
+from urllib.parse import urlencode
+import pytest
+from tests.test_hr_ui117 import company_context, document, shift, travel, timesheet, expense, png, op, OWN, ALL, edit_payload
+
+@pytest.fixture(scope='module')
+def company(tmp_path_factory):
+    with company_context(tmp_path_factory.mktemp('rh-ui120')) as h:
+        h.grant('hr',ALL|{'hr.people_manage'})
+        yield h
+
+def ws(h,key='hr',**filters):
+    return h.get('workspace?'+urlencode(dict(start_on='2026-10-01',end_on='2026-10-31',**filters)),key=key)
+
+def person(h,key='alice',**changes):
+    result=dict(id='',version=0,user_id=h.uid(key),title='Cadastro',phone='(00) 0000-0000',emergency_contact='Contato fictício',job_title='',admitted_on='',notes='')
+    result.update(changes);return result
+
+def test_personnel_reuses_identity_and_restricts_professional_edits(company):
+    h=company;before=h.uid('alice')
+    row=h.action('save_person',person(h))
+    assert row['user_id']==before and row['title']=='Cadastro do colaborador'
+    h.action('save_person',person(h),code=409)
+    h.action('save_person',person(h,id=row['id'],version=row['version'],job_title='Cargo indevido'),code=403)
+    row=h.action('save_person',person(h,id=row['id'],version=row['version'],job_title='Técnica de levantamento'),key='hr')
+    assert row['job_title']=='Técnica de levantamento'
+    h.get('people/'+row['id'],key='bob',code=404)
+    h.get('people/'+row['id'],key='review',code=404)
+    assert row['id'] not in str(ws(h,'review'))
+    assert row['id'] in str(ws(h,'alice'))
+    assert h.uid('alice')==before
+
+def test_uploaded_is_not_verified_and_edits_invalidate_review(company):
+    h=company
+    d=h.action('save_document',document(h.uid('alice'),title='Passaporte de teste',type='passport',expires_on='2026-10-20'))
+    assert d['verification_status']=='pending'
+    h.action('verify_document',dict(id=d['id'],version=d['version'],decision='verify',comment=''),key='hr',code=409)
+    d=h.action('add_attachment',dict(kind='documents',id=d['id'],version=d['version'],filename='passaporte-teste.png',data=base64.b64encode(png()).decode()))
+    h.action('verify_document',dict(id=d['id'],version=d['version'],decision='verify',comment=''),key='alice',code=403)
+    d=h.action('verify_document',dict(id=d['id'],version=d['version'],decision='verify',comment='Dados e anexo conferidos.'),key='hr')
+    assert d['verification_status']=='verified' and d['verified_by']['user_id']==h.uid('hr')
+    d=h.action('save_document',edit_payload(document,d,title='Passaporte corrigido'))
+    assert d['verification_status']=='pending' and d['verified_by'] is None
+    history=h.get('documents/'+d['id']+'/history')['items']
+    assert any(r['action']=='verify_document' for r in history)
+
+def test_conference_by_evidence_editor_is_forbidden(company):
+    h=company
+    d=h.action('save_document',document(h.uid('bob')),key='hr')
+    d=h.action('add_attachment',dict(kind='documents',id=d['id'],version=d['version'],filename='teste.png',data=base64.b64encode(png()).decode()),key='hr')
+    h.action('verify_document',dict(id=d['id'],version=d['version'],decision='verify',comment=''),key='hr',code=403)
+    d=h.action('verify_document',dict(id=d['id'],version=d['version'],decision='verify',comment=''),key='admin')
+    assert d['verification_status']=='verified'
+
+def test_calendar_crewchanging_overlap_missing_docs_and_no_inferred_hours(company):
+    h=company;uid=h.uid('alice')
+    first=h.action('save_shift',shift(uid,title='Embarque Alfa',project='Projeto Alfa',required_documents=['passport','cbsp'],work_days=14,rest_days=14),key='hr')
+    second=h.action('save_shift',shift(uid,title='Folga sobreposta',assignment_type='rest',location='',start_on='2026-10-20',end_on='2026-10-30'),key='hr')
+    result=ws(h)
+    assert any(w['code']=='overlap' and {w['id'],w['other_id']}=={first['id'],second['id']} for w in result['warnings'])
+    assert any(w['code']=='document_requirement' and w['id']==first['id'] for w in result['warnings'])
+    assert any(w['code']=='expires_during_assignment' for w in result['warnings'])
+    assert {'Embarque previsto','Desembarque previsto','Folga programada'}<=set(e['label'] for e in result['events'])
+    assert not any(r['kind']=='timesheets' for r in result['records'])
+    bob=next(r for r in result['roster'] if r['id']==h.uid('bob'))
+    assert bob['programming_status']=='not_recorded'
+    filtered=ws(h,project='Projeto Alfa')
+    assert {p['id'] for p in filtered['people']}=={uid}
+    mine=ws(h,'alice')
+    assert {p['id'] for p in mine['people']}=={uid}
+    assert h.uid('bob') not in str(mine)
+
+def test_schedule_grant_does_not_reveal_documents(company):
+    h=company;h.add_user('schedule120','Coordenador de escala fictício')
+    h.grant('schedule120',{'hr.view_own','hr.shifts_manage'})
+    result=ws(h,'schedule120')
+    assert not any(r['kind']=='documents' for r in result['records'])
+    assert not any(w['code'] in ('document_requirement','document_expiry','verification_pending','expires_during_assignment') for w in result['warnings'])
+    assert any(r['kind']=='shifts' for r in result['records'])
+
+@pytest.mark.parametrize('kind,builder,save,submit,review',[
+ ('timesheets',timesheet,'save_timesheet','submit_timesheet','review_timesheet'),
+ ('expenses',expense,'save_expense','submit_expense','review_expense')])
+def test_rejection_is_independent_immutable_and_traced(company,kind,builder,save,submit,review):
+    h=company;r=h.action(save,builder(h.uid('alice')))
+    r=h.action(submit,dict(id=r['id'],version=r['version']))
+    h.action(review,dict(id=r['id'],version=r['version'],decision='reject',comment=''),key='hr',code=422)
+    r=h.action(review,dict(id=r['id'],version=r['version'],decision='reject',comment='Motivo da rejeição registrado.'),key='hr')
+    assert r['status']=='rejected'
+    h.action(save,edit_payload(builder,r),code=409)
+    assert h.get(kind+'/'+r['id']+'/history')['items'][0]['action']==review
+    assert any(x['id']==r['id'] and x['status']=='rejected' for x in ws(h,'alice')['records'])
+
+def test_workspace_date_hub_and_revoked_access(company):
+    h=company
+    h.get('workspace?start_on=2026-01-01&end_on=2026-12-31',code=422)
+    h.get('workspace?start_on=2026-10-31&end_on=2026-10-01',code=422)
+    response=h.client.get('/api/hr/workspace?start_on=2026-10-01&end_on=2026-10-31',headers={'Authorization':h.headers('alice')['Authorization']})
+    assert response.status_code==409
+    h.grant('bob',set())
+    h.get('workspace?start_on=2026-10-01&end_on=2026-10-31',key='bob',code=403)
+    h.grant('bob',OWN)
+
+
+def need(h,**changes):
+    r=dict(id='',version=0,user_id=h.uid('hr'),title='Necessidade de campanha fictícia',job_title='Técnico de levantamento',location='Embarcação fictícia',project='Campanha fictícia',start_on='2026-10-01',end_on='2026-10-31',headcount=2,status='planned',notes='Dados fictícios')
+    r.update(changes);return r
+
+def test_coverage_requires_saved_need_confirmed_linked_people_and_deduplicates(company):
+    h=company;n=h.action('save_need',need(h),key='hr')
+    def coverage(): return next(c for c in ws(h)['coverage'] if c['need']['id']==n['id'])
+    assert coverage()['maximum_missing']==2 and coverage()['gap_days']==31
+    a=h.action('save_shift',shift(h.uid('alice'),need_id=n['id'],location=n['location'],project=n['project'],start_on='2026-10-01',end_on='2026-10-31',status='planned'),key='hr')
+    assert coverage()['days'][0]['proposed']==1 and coverage()['days'][0]['confirmed']==0
+    a=h.action('save_shift',dict({k:v for k,v in a.items() if k in __import__('app.hr',fromlist=['SAVE_FIELDS']).SAVE_FIELDS['shifts']},status='confirmed'),key='hr')
+    assert coverage()['maximum_missing']==1
+    h.action('save_shift',shift(h.uid('alice'),need_id=n['id'],location=n['location'],project=n['project'],start_on='2026-10-01',end_on='2026-10-31',status='confirmed'),key='hr')
+    assert coverage()['days'][0]['confirmed']==1
+    h.action('save_shift',shift(h.uid('bob'),need_id=n['id'],location=n['location'],project=n['project'],start_on='2026-10-16',end_on='2026-10-31',status='confirmed'),key='hr')
+    assert coverage()['gap_days']==15 and coverage()['days'][-1]['missing']==0
+    filtered=next(c for c in ws(h,user_id=h.uid('alice'))['coverage'] if c['need']['id']==n['id'])
+    assert filtered['days'][-1]['missing']==0  # company demand isn't distorted by a person filter
+    assert not any(c['need']['id']==n['id'] for c in ws(h,location='Other location')['coverage'])
+
+def test_need_permissions_and_invalid_links(company):
