@@ -0,0 +1,147 @@
+"""Read-only RH projections over canonical accounts, departments and HR records.
+No shadow roster, inferred availability, payroll or eligibility decision.
+"""
+import json
+from datetime import date, timedelta
+from .hr import KINDS, MANAGE, current, expiry_status, day, period, ident
+from .store import Problem
+
+DOC_LABELS={'passport':'Passaporte','seaman_book':'Caderneta de inscrição e registro (CIR)',
+ 'medical':'Documento de saúde ocupacional','training':'Certificado de capacitação',
+ 'visa':'Visto / autorização de trabalho','cbsp':'CBSP','huet':'HUET','other':'Outro documento'}
+
+def project_workspace(hr, actor, start_on, end_on, user_id='', location='', project='', department_id=''):
+    start_on=day(start_on,'Início'); end_on=day(end_on,'Fim'); period(start_on,end_on)
+    if (date.fromisoformat(end_on)-date.fromisoformat(start_on)).days>92:
+        raise Problem(422,'Escolha um período de até 93 dias para consultar o RH.')
+    if user_id: ident(user_id)
+    if department_id: ident(department_id)
+    if any(not isinstance(x,str) or len(x)>240 for x in (location,project)):
+        raise Problem(422,'Use filtros de até 240 caracteres.')
+    with hr.store.connection() as c:
+        user,caps=current(c,actor)
+        manager=any(caps[k] for k in MANAGE.values())
+        if user_id and user_id!=user['id'] and not manager:
+            raise Problem(404,'Cadastro indisponível para esta conta.')
+        from .departments import membership_ids
+        accounts=c.execute('SELECT id,name,login_id,enabled FROM users ORDER BY name,id').fetchall() if manager else [user]
+        departments={r['id']:r['name'] for r in c.execute('SELECT id,name FROM ops_departments WHERE active=1')}
+        people=[]
+        for person in accounts:
+            if user_id and person['id']!=user_id: continue
+            ids=membership_ids(c,person['id'],active_only=True)
+            if department_id and department_id not in ids: continue
+            people.append({'id':person['id'],'name':person['name'],'login_id':person['login_id'],
+                'enabled':bool(person['enabled']), 'departments':[{'id':i,'name':departments[i]} for i in ids if i in departments]})
+        allowed_people={p['id'] for p in people}
+        rows=[]; needs=[]; coverage_shifts=[]; limit=3000; truncated=False
+        # Filter authorization before applying the bound. Unauthorized rows cannot
+        # consume the limit or influence any count or warning.
+        for row in c.execute('SELECT body FROM hr_records ORDER BY updated_at DESC,id'):
+            r=json.loads(row[0])
+            if r['kind']=='needs' and caps['hr.shifts_manage'] and r['status']!='cancelled' and r['end_on']>=start_on and r['start_on']<=end_on:
+                if (not location or location.casefold() in r['location'].casefold()) and (not project or project.casefold() in r['project'].casefold()): needs.append(hr._present(r))
+                continue
+            if r['kind']=='shifts' and caps['hr.shifts_manage'] and r.get('need_id') and r['status']!='cancelled' and r['end_on']>=start_on and r['start_on']<=end_on:
+                coverage_shifts.append(r)
+            if r['kind'] not in KINDS or r['user_id'] not in allowed_people or not hr._read_allowed(r,user,caps): continue
