+let context;
+function node(id=''){
+ const n={id,value:'',textContent:'',disabled:false,hidden:false,checked:false,open:false,isConnected:true,dataset:{},style:{},focus(options){context.document.activeElement=this;this.focusOptions=options;},scrollIntoView(options){this.scrollOptions=options;},contains(other){return !!other?.inResults;},querySelector(){return node();},setAttribute(key,value){(this.attrs||(this.attrs={}))[key]=value;},closest(){return null;},showModal(){this.open=true;},close(){this.open=false;this.onclose?.();}};
