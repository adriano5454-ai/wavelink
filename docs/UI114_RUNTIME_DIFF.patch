+const exposed='worksheetMappingFacts,worksheetMappingMarkup,worksheetAttention,worksheetFilter,changeWorksheetFilter,refreshWorksheetFilters,refreshInventory,validInventoryMapping,captureAppliedMapping,lastAppliedMapping,restoreMapping,pendingMappingChanges,mappingRecovery,chooseHeader,inventoryContext,inventoryViewNavigation,inventoryOverviewAvailable,jumpInventoryView,bindInventoryNavigation,mapping,mappingStatus,mappingQuality,inventoryState,inventorySheetsPayload,rowData,rowPage,rowPicker,rowPickerResults,rowView,sourceReviewRows,sourceReviewNote,editInventoryItem,checkedItemEdits,openInventoryItem,editInventoryRows,changeRowSelection,changeRowView,editRelationship,applyMapping,collect,paint,review,request,inspectInventorySheet,checkedReviewedInventoryDraft,selectedSheets,includedRows,lock';
